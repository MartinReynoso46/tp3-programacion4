@url = http://localhost:3000/api
@token = PEGAR_TOKEN_AQUI

### Listar
GET {{url}}/conductores
Authorization: Bearer {{token}}

### Crear
POST {{url}}/conductores
Content-Type: application/json
Authorization: Bearer {{token}}

{ "nombre": "Juan", "apellido": "Pérez", "numero_documento": "30123456", "numero_licencia": "LIC-001",
  "fecha_alta_licencia": "2020-03-10", "fecha_vencimiento_licencia": "2027-03-10" }

### Actualizar
PUT {{url}}/conductores/1
Content-Type: application/json
Authorization: Bearer {{token}}

{ "nombre": "Juan", "apellido": "Pérez", "numero_documento": "30123456", "numero_licencia": "LIC-001",
  "fecha_alta_licencia": "2020-03-10", "fecha_vencimiento_licencia": "2028-03-10" }

### Eliminar
DELETE {{url}}/conductores/1
Authorization: Bearer {{token}}
